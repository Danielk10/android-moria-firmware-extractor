    <!-- About & Licenses Unified Dialog -->
    <string name="about_licenses_dialog_title">About &amp; Licenses</string>
    <string name="str_about_licenses_html"><![CDATA[<h2>Moria Firmware Extractor</h2><p>Advanced application for forensic firmware extraction, archive unpacking, image parsing, and entropy analysis powered by native <b>moria</b> and <b>libarchive</b>.</p><p><b>Pipeline Workflow:</b><br/><code>moria -e firmware.bin &rarr; mithril firmware.bin.extracted/</code></p><hr/><b>&#11088; Original Tool Creator &amp; Engine Author:</b><br/><b>Matt Brown (nmatt0)</b> &mdash; Creator of <b>moria</b> (Native C++ Engine)<br/>Official Repository: <a href="https://github.com/nmatt0/moria">https://github.com/nmatt0/moria</a> &bull; MIT License<br/><br/><b>&#128241; Android Port &amp; App Developer:</b><br/><b>Danielk10</b> &mdash; Android UI, UNIX Sandbox Terminal &amp; Native JNI Packaging<br/>Repository: <a href="https://github.com/Danielk10/android-moria-firmware-extractor">Danielk10/android-moria-firmware-extractor</a> &bull; Apache 2.0<br/><hr/><h3>Open Source Licenses</h3><p>This software integrates native open-source binaries and shared libraries:</p><ul><li><b>Moria CLI</b> &mdash; MIT License (<a href="https://github.com/nmatt0/moria">nmatt0/moria</a>) &bull; Author: Matt Brown</li><li><b>libarchive</b> &mdash; BSD 2-Clause License (<a href="https://github.com/libarchive/libarchive">libarchive.org</a>)</li><li><b>bsdunzip</b> &mdash; BSD 2-Clause License</li><li><b>ICU (Unicode Components)</b> &mdash; Unicode / ICU License (<a href="https://icu.unicode.org">icu.unicode.org</a>)</li><li><b>OpenSSL / libcrypto</b> &mdash; Apache 2.0 (<a href="https://www.openssl.org">openssl.org</a>)</li><li><b>Zstandard (libzstd)</b> &mdash; BSD 3-Clause License (<a href="https://facebook.github.io/zstd/">facebook/zstd</a>)</li><li><b>LZ4 (liblz4)</b> &mdash; BSD 2-Clause License (<a href="https://lz4.org">lz4.org</a>)</li><li><b>XZ / liblzma</b> &mdash; Public Domain / LGPL 2.1 (<a href="https://tukaani.org/xz/">tukaani.org/xz</a>)</li><li><b>zlib</b> &mdash; zlib License (<a href="https://zlib.net">zlib.net</a>)</li><li><b>libxml2</b> &mdash; MIT License (<a href="https://gitlab.gnome.org/GNOME/libxml2">xmlsoft.org</a>)</li><li><b>libiconv &amp; libcharset</b> &mdash; LGPL 2.1</li><li><b>libacl</b> &mdash; LGPL 2.1</li></ul>]]></string>

