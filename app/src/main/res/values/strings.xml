    <!-- About & Licenses Dialogs -->
    <string name="str_about_html"><![CDATA[<h2>Moria Firmware Extractor</h2><p>Advanced application for forensic firmware extraction, archive unpacking, image parsing, and hardware reverse engineering powered by native <b>moria</b> and <b>libarchive</b>.</p><p><b>Pipeline Workflow:</b><br/><code>moria -e firmware.bin &rarr; mithril firmware.bin.extracted/</code></p><hr/><b>Project License:</b> Apache 2.0<br/><b>Author:</b> Daniel Elias Diamon Vazquez<br/><b>GitHub:</b> <a href="https://github.com/Danielk10/moria-firmware-extractor">moria-firmware-extractor</a><br/><br/><b>Documentation:</b> skills/moria/README.md<br/>]]></string>

    <string name="licenses_dialog_title">Open Source Licenses</string>
