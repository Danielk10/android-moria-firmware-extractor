prefix=/data/data/com.diamon.moria/files/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libarchive
Description: library that can create and read several streaming archive formats
Version: 3.9.0
Cflags: -I${includedir}
Cflags.private: -DLIBARCHIVE_STATIC
Libs: -L${libdir} -larchive
Libs.private:  -lz -llzma -llz4 -lzstd -lcrypto -liconv -lcharset -lxml2 -lacl -L/data/data/com.termux/files/usr/lib -lxml2 -lm -pthread -liconv -lz -licuuc -licudata -lpthread -lm
Requires.private: 
